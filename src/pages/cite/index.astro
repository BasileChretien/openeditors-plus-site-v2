---
import Base from "../../layouts/Base.astro";
---

<Base title="Cite — Open Editors Plus" path="cite" description="How to cite Open Editors Plus in your research. BibTeX, APA, and other citation formats.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4">How to cite</h1>
    <p class="text-text-secondary text-lg mb-10">
      If you use Open Editors Plus in your research, please cite the dataset. This helps us track impact and justify continued development.
    </p>

    <!-- Dataset citation -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Dataset</h2>

      <!-- APA -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-sm text-text-muted uppercase tracking-wide">APA 7th</h3>
          <button class="copy-btn text-xs text-brand-600 hover:text-brand-800 font-medium" data-target="apa">Copy</button>
        </div>
        <div id="apa" class="bg-surface-dim rounded-lg border border-border p-4 text-sm leading-relaxed">
          Chretien, B. (2026). <em>Open Editors Plus 2026: Editorial Board Composition of 15,000+ Academic Journals</em> [Data set]. Zenodo. https://doi.org/10.5281/zenodo.19590816
        </div>
      </div>

      <!-- BibTeX -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-sm text-text-muted uppercase tracking-wide">BibTeX</h3>
          <button class="copy-btn text-xs text-brand-600 hover:text-brand-800 font-medium" data-target="bibtex">Copy</button>
        </div>
        <div id="bibtex" class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 font-mono">@dataset{"{"}chretien2026openeditors,
  author    = {"{"}Chretien, Basile{"}"},
  title     = {"{"}Open Editors Plus 2026: Editorial Board
               Composition of 15,000+ Academic Journals{"}"},
  year      = {"{"}2026{"}"},
  publisher = {"{"}Zenodo{"}"},
  doi       = {"{"}10.5281/zenodo.19590816{"}"},
  url       = {"{"}https://openeditors-plus.org{"}"}
{"}"}</pre>
        </div>
      </div>

      <!-- RIS -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-sm text-text-muted uppercase tracking-wide">RIS (EndNote, Zotero)</h3>
          <button class="copy-btn text-xs text-brand-600 hover:text-brand-800 font-medium" data-target="ris">Copy</button>
        </div>
        <div id="ris" class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 font-mono">TY  - DATA
AU  - Chretien, Basile
TI  - Open Editors Plus 2026: Editorial Board Composition of 15,000+ Academic Journals
PY  - 2026
PB  - Zenodo
DO  - 10.5281/zenodo.19590816
UR  - https://openeditors-plus.org
ER  -</pre>
        </div>
      </div>
    </section>

    <!-- Author info -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Author</h2>
      <div class="flex items-start gap-4">
        <img src="/img/basile-chretien.jpg" alt="Basile Chretien" class="w-16 h-16 rounded-full object-cover flex-shrink-0 border-2 border-brand-100" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <div class="w-16 h-16 bg-brand-100 text-brand-700 rounded-full items-center justify-center font-bold text-lg flex-shrink-0 hidden">
          BC
        </div>
        <div>
          <h3 class="font-bold text-lg">Basile Chretien</h3>
          <p class="text-sm text-text-secondary">
            Neuropresage Team (PhIND, UMR-S U1237), Normandie Université, UNICAEN, INSERM,<br>
            GIP Cyceron, Caen, France
          </p>
          <div class="flex items-center gap-4 mt-2">
            <a href="https://orcid.org/0000-0002-7483-2489" class="inline-flex items-center gap-1 text-sm text-brand-600 hover:underline" target="_blank" rel="noopener noreferrer">
              <svg class="w-4 h-4" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="128" cy="128" r="128" fill="#A6CE39"/>
                <path d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4z" fill="white"/>
                <circle cx="78.7" cy="62.4" r="10.1" fill="white"/>
              </svg>
              0000-0002-7483-2489
            </a>
            <a href="https://www.linkedin.com/in/basile-chretien/" class="inline-flex items-center gap-1 text-sm text-text-secondary hover:opacity-80" target="_blank" rel="noopener noreferrer">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="#0A66C2">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a href="https://github.com/BasileChretien" class="inline-flex items-center gap-1 text-sm text-text-secondary hover:opacity-80" target="_blank" rel="noopener noreferrer">
              <svg class="w-4 h-4" fill="#181717" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- License -->
    <section>
      <h2 class="text-2xl font-bold mb-4">License</h2>
      <div class="flex items-start gap-4 bg-surface-dim rounded-lg border border-border p-6">
        <div class="text-3xl flex-shrink-0">
          <svg class="w-12 h-12 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <path d="M15 9.5c-.5-1-1.5-1.5-3-1.5-2 0-3 1-3 2.5s1.5 2 3 2.5 3 1.5 3 3-1.5 2.5-3 2.5c-1.5 0-2.5-.5-3-1.5"/>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-1">CC0 1.0 Universal — Public Domain Dedication</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            This dataset is released under CC0 1.0. You can copy, modify, distribute, and use the data for any purpose, including commercial, without asking permission.
            We kindly ask that you cite the dataset if you use it in your research, though this is not legally required.
            The underlying editorial board information was collected from publicly available publisher websites.
          </p>
          <p class="text-sm text-text-secondary leading-relaxed mt-3">
            <strong class="text-text-primary">One caveat.</strong> CC0 waives copyright and database rights only — it does not waive the
            data-protection rights of the individuals described. If you reuse the records you remain
            responsible for complying with applicable data-protection law (in particular the EU GDPR).
            See <a href="/privacy" class="text-brand-600 hover:underline">Privacy &amp; Data Protection</a>
            and <a href="/corrections" class="text-brand-600 hover:underline">Corrections &amp; data rights</a>.
          </p>
          <a href="https://creativecommons.org/publicdomain/zero/1.0/" class="inline-flex items-center gap-1 text-sm text-brand-600 hover:underline mt-2" target="_blank" rel="noopener noreferrer">
            View full license text
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>
      </div>
    </section>
  </div>

  <script>
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const el = document.getElementById(targetId);
        if (!el) return;
        const text = el.innerText;
        navigator.clipboard.writeText(text);
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 2000);
      });
    });
  </script>
</Base>
