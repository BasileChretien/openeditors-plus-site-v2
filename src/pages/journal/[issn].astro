---
// One page per ISSN-L: /journal/<ISSN-L>. Aggregates only. The members
// themselves stay in the explorer, which reads them in the browser, and on the
// publisher's own page, which this page links to as the current list. An
// ISSN-L that has left the dataset keeps its URL with a short page instead
// (RetiredJournal).
import Base from "../../layouts/Base.astro";
import RetiredJournal from "../../components/RetiredJournal.astro";
import table from "../../../public/api/journal_pages.json";
import codebook from "../../../public/api/codebook.json";
import fields from "../../../public/api/fields.json";
import publishers from "../../../public/api/publishers.json";
import release from "../../../public/api/release_meta.json";
import releaseNotes from "../release-notes/index.astro?raw";
import { slugify } from "../../lib/slugify";
import { oneDecimal } from "../../lib/figures";
import {
  boardUrl, displayTitle, issnSources, journalPages, MIN_GENDER_RESOLVED, releaseHasIssns, releaseNoteVersions,
  retiredPages, ROLE_LABELS, type JournalPage, type JournalTable, type Listing, type RetiredJournalPage,
} from "../../lib/journals";

export function getStaticPaths() {
  // Once the served release has the print and electronic ISSNs, journal_pages.json must carry them.
  const pages = journalPages(table as JournalTable, { issnsReleased: releaseHasIssns(codebook) });
  // What a retired page links to: its publisher's page and its release's notes.
  const links = {
    publisherPages: new Set((publishers as { publisher: string }[]).map((p) => slugify(p.publisher))),
    releaseNotes: releaseNoteVersions(releaseNotes),
    version: release.version,
  };
  return [
    ...pages.map((page) => ({ params: { issn: page.issn_l }, props: { page } })),
    ...retiredPages(pages, links).map((retired) => ({ params: { issn: retired.issn_l }, props: { retired } })),
  ];
}

const { page, retired } = Astro.props as { page?: JournalPage; retired?: RetiredJournalPage };
const [main, ...others] = page?.listings ?? ([] as Listing[]);
const fieldPages = new Set((fields as { field: string }[]).map((f) => f.field));
const releaseDate = new Date(`${release.release_date}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
});
const dateLabel = (iso: string) => iso
  ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })
  : "";
const yesNo = (v: boolean) => (v ? "Yes" : "No");
const issnPortal = (issn: string) => "https://portal.issn.org/resource/ISSN/" + issn;
// "ISSN (print) and E-ISSN as typed by the NLM Catalog.", or "" for a listing with neither.
const issnNote = (l: Listing) => {
  const typed = [l.issn_print && "ISSN (print)", l.issn_electronic && "E-ISSN"].filter(Boolean);
  return typed.length ? `${typed.join(" and ")} as typed by ${issnSources(l.issn_type_source)}. ` : "";
};
const name = main ? displayTitle(main.journal) : "";
const title = `${name} — Editorial Board Indicators`;
const description = `Editorial board of ${name} (ISSN-L ${page?.issn_l}): size, countries, inferred gender balance and roles, from Open Editors Plus ${release.version}.`;
const path = `journal/${page?.issn_l}`;
---

{retired ? <RetiredJournal retired={retired} /> : (
<Base title={title} description={description} path={path}
  breadcrumbs={[{ name: "Journals", url: "journals" }, { name, url: path }]}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-xs text-text-muted mb-6">
      <a href="/">Home</a> / <a href="/journals">Journals</a> / <span class="text-text-primary font-medium">{name}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-bold mb-2">{name}</h1>
    <p class="text-text-secondary text-lg mb-1">
      <a href={"/publisher/" + slugify(main.publisher)} class="text-brand-600 hover:underline">{main.publisher}</a>
      <span class="mx-2 text-text-muted">·</span>
      ISSN-L <a href={issnPortal(page.issn_l)} target="_blank" rel="noopener" class="font-mono text-brand-600 hover:underline">{page.issn_l}</a>
    </p>
    <p class="text-xs text-text-muted mb-8">
      Snapshot: board collected {dateLabel(main.collected) || "in " + release.data_version}, released in
      Open Editors Plus {release.version} ({releaseDate}). Boards change; the publisher's page is the current list.
    </p>

    {(page?.listings ?? []).map((l) => {
      const roles = Object.entries(ROLE_LABELS).filter(([key]) => l.roles[key] > 0);
      const showGender = l.pct_female !== null && (l.gender_resolved ?? 0) >= MIN_GENDER_RESOLVED;
      const board = boardUrl(l.source_url);
      const explore = "/explore?journal=" + encodeURIComponent(l.journal) + "&publisher=" + encodeURIComponent(l.publisher);
      return (
        <section class="mb-12">
          {others.length > 0 && (
            <h2 class="text-xl font-bold mb-4">{displayTitle(l.journal)} <span class="text-sm font-normal text-text-muted">({l.publisher})</span></h2>
          )}
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-8">
            <div class="bg-white rounded-xl border border-border p-4 text-center shadow-sm">
              <div class="text-xl font-bold text-brand-800">{l.board_size.toLocaleString("en-US")}</div>
              <div class="text-[10px] text-text-muted mt-1">Editors</div>
            </div>
            <div class="bg-white rounded-xl border border-border p-4 text-center shadow-sm">
              <div class="text-xl font-bold text-brand-800">{l.positions.toLocaleString("en-US")}</div>
              <div class="text-[10px] text-text-muted mt-1">Positions</div>
            </div>
            <div class="bg-white rounded-xl border border-border p-4 text-center shadow-sm">
              <div class="text-xl font-bold text-brand-800">{l.country_count.toLocaleString("en-US")}</div>
              <div class="text-[10px] text-text-muted mt-1">Countries</div>
            </div>
            <div class="bg-white rounded-xl border border-border p-4 text-center shadow-sm">
              <div class="text-xl font-bold text-brand-800">{showGender ? oneDecimal(l.pct_female as number) + "%" : "—"}</div>
              <div class="text-[10px] text-text-muted mt-1">Women (inferred)</div>
            </div>
            <div class="bg-white rounded-xl border border-border p-4 text-center shadow-sm">
              <div class="text-xl font-bold text-brand-800">{l.mean_h_index > 0 ? oneDecimal(l.mean_h_index) : "—"}</div>
              <div class="text-[10px] text-text-muted mt-1">Mean editor h-index</div>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="bg-white rounded-xl border border-border p-6 shadow-sm">
              <h3 class="font-bold text-lg mb-4">Positions by role</h3>
              {roles.length > 0 ? (
                <table class="w-full text-sm">
                  <tbody>
                    {roles.map(([key, label]) => (
                      <tr class="border-b border-border last:border-0">
                        <td class="py-1.5">{label}</td>
                        <td class="py-1.5 text-right tabular-nums font-medium">{l.roles[key].toLocaleString("en-US")}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p class="text-sm text-text-muted">No role could be classified.</p>
              )}
              <p class="text-[10px] text-text-muted mt-3">
                Positions, not people: one editor can hold two titles on a board. Titles are mapped to roles as described in the <a href="/methodology#role-taxonomy" class="underline">methodology</a>.
              </p>
            </div>

            <div class="bg-white rounded-xl border border-border p-6 shadow-sm">
              <h3 class="font-bold text-lg mb-4">Journal</h3>
              <dl class="grid grid-cols-2 gap-y-1.5 text-sm">
                {l.issn_print && (<>
                  <dt class="text-text-muted">ISSN (print)</dt>
                  <dd><a href={issnPortal(l.issn_print)} target="_blank" rel="noopener" class="font-mono text-brand-600 hover:underline">{l.issn_print}</a></dd>
                </>)}
                {l.issn_electronic && (<>
                  <dt class="text-text-muted">E-ISSN</dt>
                  <dd><a href={issnPortal(l.issn_electronic)} target="_blank" rel="noopener" class="font-mono text-brand-600 hover:underline">{l.issn_electronic}</a></dd>
                </>)}
                <dt class="text-text-muted">Field</dt>
                <dd>{l.field ? (fieldPages.has(l.field) ? <a href={"/field/" + slugify(l.field)} class="text-brand-600 hover:underline">{l.field}</a> : l.field) : "—"}</dd>
                <dt class="text-text-muted">Open access (DOAJ)</dt><dd>{yesNo(l.is_oa)}</dd>
                <dt class="text-text-muted">Scopus</dt><dd>{yesNo(l.indexed_scopus)}</dd>
                <dt class="text-text-muted">Web of Science</dt><dd>{yesNo(l.indexed_wos)}</dd>
                <dt class="text-text-muted">PubMed</dt><dd>{yesNo(l.indexed_pubmed)}</dd>
                <dt class="text-text-muted">NPI level</dt><dd>{l.npi_level || "—"}</dd>
                <dt class="text-text-muted">Citedness quartile</dt><dd>{l.impact_quartile || "—"}</dd>
              </dl>
              <p class="text-[10px] text-text-muted mt-3">
                {issnNote(l)}The citedness quartile is computed within the field from OpenAlex citations, not taken from Clarivate or Scopus. See the notes on the <a href="/journals" class="underline">journal statistics</a> page.
              </p>
            </div>
          </div>

          <p class="text-[11px] text-text-muted mb-6">
            {showGender
              ? `Women (inferred): share of the ${(l.gender_resolved ?? 0).toLocaleString("en-US")} editors whose gender could be inferred from their first name; not self-reported.`
              : `This page does not show the share of women for a board with fewer than ${MIN_GENDER_RESOLVED} editors of inferred gender.`}
            {" "}Each editor is counted once per board.
          </p>

          <div class="flex flex-wrap gap-2">
            {board && (
              <a href={board} target="_blank" rel="noopener" class="px-3 py-1.5 text-xs text-white bg-brand-600 rounded-full hover:bg-brand-700">Current board on the publisher's site</a>
            )}
            <a href={explore} class="px-3 py-1.5 text-xs text-brand-600 border border-brand-200 rounded-full hover:bg-brand-50">Board members in the explorer</a>
          </div>
        </section>
      );
    })}

    <div class="border-t border-border pt-8">
      <h2 class="font-bold text-lg mb-4">Browse more</h2>
      <div class="flex flex-wrap gap-2">
        <a href="/journals" class="px-3 py-1.5 text-xs text-brand-600 border border-brand-200 rounded-full hover:bg-brand-50">All journals</a>
        <a href={"/publisher/" + slugify(main.publisher)} class="px-3 py-1.5 text-xs text-brand-600 border border-brand-200 rounded-full hover:bg-brand-50">{main.publisher}</a>
        <a href="/download" class="px-3 py-1.5 text-xs text-brand-600 border border-brand-200 rounded-full hover:bg-brand-50">Download the dataset</a>
      </div>
    </div>
  </div>
</Base>
)}
