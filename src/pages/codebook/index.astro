---
import Base from "../../layouts/Base.astro";
import codebook from "../../../public/api/codebook.json";
import release from "../../../public/api/release_meta.json";

// Provenance tag for every column. Helps users assess which columns
// are trustworthy ground truth vs. inferred/derived values that may
// carry systematic bias.
//
//   collected — direct from publisher HTML (ground truth for that snapshot)
//   external  — resolved against an authoritative third-party API/registry
//              (ROR, OpenAlex, DOAJ, COPE, NPI, etc.)
//   inferred  — algorithmic or ML inference; may be biased, esp. for
//              names/scripts outside the training distribution
//   computed  — derived arithmetically from other columns in this dataset
type Source = "collected" | "external" | "inferred" | "computed";

// Each column's text is its description in this release's deposited
// codebook: public/api/codebook.json, written by the data repository's
// build_release.py, which renders any figure a description quotes from the
// release data. The texts are never typed here, so they cannot go stale.
const columns = [
  { group: "Core", cols: [
    { name: "publisher", display: "Publisher", type: "string", source: "collected" as Source },
    { name: "journal", display: "Journal", type: "string", source: "collected" as Source },
    { name: "editor", display: "Name", type: "string", source: "collected" as Source },
    { name: "first_name", display: "First name", type: "string", source: "computed" as Source },
    { name: "last_name", display: "Last name", type: "string", source: "computed" as Source },
    { name: "role", display: "Role (raw)", type: "string", source: "collected" as Source },
    { name: "role_std", display: "Role (standardized)", type: "string", source: "computed" as Source },
    { name: "affiliation", display: "Affiliation", type: "string", source: "collected" as Source },
    { name: "orcid", display: "ORCID", type: "string", source: "collected" as Source },
    { name: "source_url", display: "Source URL", type: "string", source: "collected" as Source },
    { name: "scraped_at", display: "Collected at", type: "datetime", source: "collected" as Source },
  ]},
  { group: "Identity", cols: [
    { name: "editor_key", display: "Editor key", type: "string", source: "computed" as Source },
  ]},
  { group: "Gender", cols: [
    { name: "gender", display: "Gender", type: "string", source: "inferred" as Source },
    { name: "gender_raw", display: "Gender (raw)", type: "string", source: "inferred" as Source },
    { name: "gender_prob", display: "Gender weight", type: "float", source: "inferred" as Source },
    { name: "gender_nobs", display: "WGND sample size", type: "int", source: "inferred" as Source },
    { name: "gender_source", display: "Gender source", type: "string", source: "inferred" as Source },
  ]},
  { group: "Institution (ROR)", cols: [
    { name: "ror_id", display: "ROR ID", type: "string", source: "external" as Source },
    { name: "ror_name", display: "Institution", type: "string", source: "external" as Source },
    { name: "ror_country", display: "Country", type: "string", source: "external" as Source },
    { name: "ror_city", display: "City", type: "string", source: "external" as Source },
    { name: "ror_state", display: "State/Province", type: "string", source: "external" as Source },
    { name: "org_type", display: "Org type", type: "string", source: "external" as Source },
    { name: "latitude", display: "Latitude", type: "float", source: "external" as Source },
    { name: "longitude", display: "Longitude", type: "float", source: "external" as Source },
  ]},
  { group: "Classification (OpenAlex)", cols: [
    { name: "scientific_domain", display: "Domain", type: "string", source: "external" as Source },
    { name: "scientific_field", display: "Field", type: "string", source: "external" as Source },
    { name: "scientific_subfield", display: "Subfield", type: "string", source: "external" as Source },
    { name: "scientific_topic", display: "Topic", type: "string", source: "external" as Source },
  ]},
  { group: "Journal identifiers", cols: [
    { name: "openalex_source_id", display: "OpenAlex source ID", type: "string", source: "external" as Source },
    { name: "issn_l", display: "ISSN-L", type: "string", source: "external" as Source },
  ]},
  { group: "Journal metrics", cols: [
    { name: "oa_2yr_mean_citedness", display: "Mean citedness (2yr)", type: "float", source: "external" as Source },
    { name: "oa_journal_h_index", display: "Journal h-index", type: "int", source: "external" as Source },
    { name: "oa_journal_works_count", display: "Journal works count", type: "int", source: "external" as Source },
    { name: "oa_journal_cited_by_count", display: "Journal citations", type: "int", source: "external" as Source },
    { name: "is_in_doaj", display: "In DOAJ", type: "bool", source: "external" as Source },
    { name: "is_oa", display: "Open access", type: "bool", source: "external" as Source },
    { name: "oa_impact_quartile", display: "OpenAlex citedness quartile (per field)", type: "string", source: "computed" as Source },
  ]},
  { group: "Editor bibliometrics", cols: [
    { name: "h_index", display: "h-index", type: "int", source: "external" as Source },
    { name: "total_publications", display: "Publications", type: "int", source: "external" as Source },
    { name: "total_citations", display: "Citations", type: "int", source: "external" as Source },
    { name: "academic_age", display: "Academic age", type: "int", source: "computed" as Source },
    { name: "orcid_source", display: "ORCID source", type: "string", source: "computed" as Source },
    { name: "openalex_author_id", display: "OpenAlex author ID", type: "string", source: "external" as Source },
    { name: "oa_match_method", display: "OpenAlex match method", type: "string", source: "computed" as Source },
  ]},
  { group: "Indexing", cols: [
    { name: "indexed_pubmed", display: "PubMed", type: "bool", source: "external" as Source },
    { name: "indexed_scopus", display: "Scopus", type: "bool", source: "external" as Source },
    { name: "indexed_wos", display: "Web of Science", type: "bool", source: "external" as Source },
    { name: "indexed_doaj", display: "DOAJ", type: "bool", source: "external" as Source },
    { name: "indexed_cope", display: "COPE", type: "bool", source: "external" as Source },
    { name: "indexed_npi", display: "NPI", type: "bool", source: "external" as Source },
    { name: "indexing_count", display: "Index count", type: "int", source: "computed" as Source },
  ]},
  { group: "Norwegian Publishing Indicator", cols: [
    { name: "npi_level", display: "NPI level", type: "string", source: "external" as Source },
    { name: "npi_discipline", display: "NPI discipline", type: "string", source: "external" as Source },
    { name: "npi_field", display: "NPI field", type: "string", source: "external" as Source },
  ]},
  { group: "Funding", cols: [
    { name: "top_funder_1", display: "Top funder 1", type: "string", source: "external" as Source },
    { name: "top_funder_1_count", display: "Funder 1 count", type: "int", source: "external" as Source },
    { name: "top_funder_2", display: "Top funder 2", type: "string", source: "external" as Source },
    { name: "top_funder_2_count", display: "Funder 2 count", type: "int", source: "external" as Source },
    { name: "top_funder_3", display: "Top funder 3", type: "string", source: "external" as Source },
    { name: "top_funder_3_count", display: "Funder 3 count", type: "int", source: "external" as Source },
  ]},
  { group: "Board diversity", cols: [
    { name: "board_size", display: "Board size", type: "int", source: "computed" as Source },
    { name: "board_pct_female", display: "% female", type: "float", source: "computed" as Source },
    { name: "board_country_count", display: "Countries on board", type: "int", source: "computed" as Source },
    { name: "board_country_hhi", display: "Country HHI", type: "float", source: "computed" as Source },
    { name: "board_institution_count", display: "Institutions on board", type: "int", source: "computed" as Source },
    { name: "board_mean_h_index", display: "Mean board h-index", type: "float", source: "computed" as Source },
  ]},
  { group: "Multi-board", cols: [
    { name: "boards_count", display: "Boards served", type: "int", source: "computed" as Source },
    { name: "publishers_count", display: "Publishers served", type: "int", source: "computed" as Source },
    { name: "is_multi_board", display: "Multi-board", type: "bool", source: "computed" as Source },
  ]},
  { group: "Metadata", cols: [
    { name: "name_script", display: "Script", type: "string", source: "inferred" as Source },
    { name: "name_script_region", display: "Script region", type: "string", source: "inferred" as Source },
    { name: "name_is_initials", display: "Name is initials", type: "bool", source: "computed" as Source },
    { name: "orcid_n_names", display: "Distinct names per ORCID", type: "int", source: "computed" as Source },
    { name: "orcid_shared_flag", display: "Shared ORCID", type: "bool", source: "computed" as Source },
    { name: "data_version", display: "Version", type: "float", source: "computed" as Source },
    { name: "enriched_at", display: "Enriched at", type: "datetime", source: "computed" as Source },
  ]},
];

// The texts must be those of the release the site serves: a data update that
// refreshed the other files but not this one would show the previous
// release's descriptions.
if (codebook.version !== release.version || String(codebook.data_version) !== String(release.data_version)) {
  throw new Error(`public/api/codebook.json describes v${codebook.version} (${codebook.data_version}), `
    + `but the site serves v${release.version} (${release.data_version})`);
}

// A column the page lists without a text, or a text for a column the page
// does not list, fails the build rather than showing a gap.
const descriptions = codebook.descriptions as Record<string, string>;
const listed = new Set(columns.flatMap((g) => g.cols.map((c) => c.name)));
const unlisted = Object.keys(descriptions).filter((name) => !listed.has(name));
if (unlisted.length) throw new Error(`codebook page does not list: ${unlisted.join(", ")}`);
for (const group of columns) {
  for (const c of group.cols as { name: string; method?: string }[]) {
    const text = descriptions[c.name];
    if (!text) throw new Error(`public/api/codebook.json has no description for ${c.name}`);
    c.method = text;
  }
}

const typeColors: Record<string, string> = {
  string: "bg-blue-100 text-blue-800",
  int: "bg-green-100 text-green-800",
  float: "bg-amber-100 text-amber-800",
  bool: "bg-purple-100 text-purple-800",
  datetime: "bg-gray-100 text-gray-800",
};

// Provenance badge styling. "inferred" deliberately uses a warning colour
// so readers can spot columns that may carry systematic bias at a glance.
const sourceBadges: Record<Source, { label: string; class: string; desc: string }> = {
  collected: { label: "collected", class: "bg-emerald-100 text-emerald-800 border border-emerald-200", desc: "Direct from publisher HTML" },
  external: { label: "external", class: "bg-sky-100 text-sky-800 border border-sky-200", desc: "From authoritative API (ROR, OpenAlex, DOAJ, COPE, NPI)" },
  inferred: { label: "inferred", class: "bg-amber-100 text-amber-800 border border-amber-300", desc: "Algorithmic / ML inference — may carry bias" },
  computed: { label: "computed", class: "bg-purple-100 text-purple-800 border border-purple-200", desc: "Derived arithmetically from other columns" },
};

// Count per source for the legend's summary badges.
const sourceCounts = columns.reduce((acc, g) => {
  for (const c of g.cols) acc[c.source] = (acc[c.source] || 0) + 1;
  return acc;
}, {} as Record<Source, number>);
---

<Base title="Codebook — Open Editors Plus" path="codebook" description="Column definitions and data dictionary for the Open Editors Plus 2026 dataset, with provenance flags marking which columns are collected, external, inferred, or computed.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4">Codebook</h1>
    <p class="text-text-secondary text-lg mb-6">
      Column definitions for the public release dataset. {columns.reduce((acc, g) => acc + g.cols.length, 0)} columns across {columns.length} groups.
    </p>

    <!-- Provenance legend -->
    <div class="bg-white border border-border rounded-xl p-5 mb-8">
      <h2 class="font-bold text-sm mb-2">Provenance</h2>
      <p class="text-xs text-text-muted mb-4">
        Every column is tagged with one of four provenance flags so you can tell at a glance how the value was produced. Hover the badge on any row for the full derivation method.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {(Object.entries(sourceBadges) as [Source, { label: string; class: string; desc: string }][]).map(([key, badge]) => (
          <div class="flex items-start gap-3">
            <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold ${badge.class} shrink-0 mt-0.5`}>
              {badge.label}
              <span class="font-sans font-normal opacity-70">· {sourceCounts[key] || 0}</span>
            </span>
            <span class="text-xs text-text-secondary">{badge.desc}</span>
          </div>
        ))}
      </div>
      <p class="text-[11px] text-text-muted mt-4 leading-relaxed">
        Inferred columns (especially <code class="font-mono">gender</code>) carry systematic bias against non-Latin-script names — see the <a href="/methodology" class="underline hover:text-brand-700">methodology</a> page for coverage details.
      </p>
    </div>

    <!-- Quick nav -->
    <nav class="flex flex-wrap gap-2 mb-10">
      {columns.map((g) => (
        <a href={`#${g.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="text-xs px-3 py-1.5 rounded-full bg-surface-dim border border-border text-text-secondary hover:bg-brand-50 hover:text-brand-700 hover:border-brand-200 transition-colors">
          {g.group}
        </a>
      ))}
    </nav>

    <!-- Column tables -->
    <div class="space-y-10">
      {columns.map((g) => (
        <section id={g.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
            {g.group}
            <span class="text-xs font-normal text-text-muted">({g.cols.length} columns)</span>
          </h2>
          <div class="overflow-x-auto border border-border rounded-lg">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-surface-dim border-b border-border">
                  <th class="text-left py-2.5 px-3 font-semibold text-xs uppercase tracking-wide text-text-muted">Column</th>
                  <th class="text-left py-2.5 px-3 font-semibold text-xs uppercase tracking-wide text-text-muted">Display name</th>
                  <th class="text-left py-2.5 px-3 font-semibold text-xs uppercase tracking-wide text-text-muted">Type</th>
                  <th class="text-left py-2.5 px-3 font-semibold text-xs uppercase tracking-wide text-text-muted">Source</th>
                  <th class="text-left py-2.5 px-3 font-semibold text-xs uppercase tracking-wide text-text-muted">Description</th>
                </tr>
              </thead>
              <tbody>
                {g.cols.map((col, i) => (
                  <tr class={i % 2 === 0 ? "bg-white" : "bg-surface-dim/50"}>
                    <td class="py-2 px-3 font-mono text-xs text-brand-700 align-top whitespace-nowrap">{col.name}</td>
                    <td class="py-2 px-3 text-text-primary align-top whitespace-nowrap">{col.display}</td>
                    <td class="py-2 px-3 align-top">
                      <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${typeColors[col.type] || "bg-gray-100 text-gray-700"}`}>
                        {col.type}
                      </span>
                    </td>
                    <td class="py-2 px-3 align-top">
                      <span
                        class={`inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold cursor-help ${sourceBadges[col.source].class}`}
                        title={sourceBadges[col.source].desc + " — " + col.method}
                      >
                        {sourceBadges[col.source].label}
                      </span>
                    </td>
                    <td class="py-2 px-3 text-text-secondary text-xs">{col.method}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
