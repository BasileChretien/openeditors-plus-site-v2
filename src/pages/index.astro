---
import Base from "../layouts/Base.astro";
import { slugify } from "../lib/slugify";
import summary from "../../public/api/summary.json";
import release from "../../public/api/release_meta.json";
import publishers from "../../public/api/publishers.json";
import countries from "../../public/api/countries.json";
import mapData from "../../public/api/map.json";

// Top cities for the ticker
const topCities = (mapData as any[])
  .filter((c: any) => c.city)
  .sort((a: any, b: any) => b.editors - a.editors)
  .slice(0, 20)
  .map((c: any) => `${c.city}: ${c.editors.toLocaleString()} editors`);

const topCountries = Object.entries(summary.top_countries).slice(0, 5);
const topFields = Object.entries(summary.top_fields).slice(0, 6);

// Highlights. All of the following are now sourced directly from
// summary.json (produced by aggregate_data.compute_summary) — DO NOT
// recompute ratios here, or the homepage will drift from the per-entity
// pages that consume the same summary.json fields.
//
//   pct_female        % of UNIQUE editors who are female (resolved
//                     denominator: male + female, excluding unknown and
//                     andy). Per-editor dedup.
//   pct_with_orcid    % of unique editors with an ORCID
//   mean_h_index      mean h-index across unique editors (once per editor)
//
const pctFemale = summary.pct_female;
// Only the COUNT of resolved-gender editors is used in the prose below.
const maleCount = summary.gender_distribution["male"] ?? 0;
const femaleCount = summary.gender_distribution["female"] ?? 0;
const totalResolved = maleCount + femaleCount;

// Gender-inference coverage. v2.7 (WGND 2.0 + the gender_prob >= 0.75
// confidence floor) lifted this from 74.8% (v2.6 gender-guesser) to
// ~82% post-threshold; pre-threshold v2.7 was 86.6%, the threshold
// trades ~5pp coverage for ~3pp precision. The headline pct_female
// barely moved because the demoted-to-unknown editors split similarly
// to the kept population, so the coverage rate is the metric that
// actually reflects the methodology change.
const pctGenderClassified = (summary as any).pct_gender_classified;

const eicCount = summary.role_distribution["editor_in_chief"] ?? 0;
---

<Base title="Open Editors Plus — Who edits science?">
  <!-- Hero -->
  <section class="hero-gradient text-white relative overflow-hidden">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="dots" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" fill="white" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dots)" />
      </svg>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-36">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
          Who edits science?
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-blue-100 leading-relaxed max-w-2xl">
          Explore the composition of editorial boards across
          <strong class="text-white">{summary.unique_journals.toLocaleString()}</strong> academic journals
          and <strong class="text-white">{summary.unique_publishers}</strong> publishers.
          The most comprehensive open dataset of scholarly editorial positions.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/explore"
            class="inline-flex items-center px-6 py-3 bg-white text-brand-900 font-semibold rounded-lg hover:bg-blue-50 transition-colors shadow-lg"
          >
            Explore the data
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/download"
            class="inline-flex items-center px-6 py-3 border-2 border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
          >
            Download dataset
          </a>
        </div>
      </div>

      <!-- Stats badges with animated counters -->
      <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 max-w-3xl">
        <div class="animate-count-up stagger-1 bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
          <div class="text-2xl sm:text-3xl font-extrabold">
            <span class="counter" data-target={Math.round(summary.unique_editors / 1000)} data-suffix="K+">0</span>
          </div>
          <div class="text-xs sm:text-sm text-blue-200 mt-1">Unique editors</div>
          <div class="text-[10px] text-blue-300/70 mt-0.5">{summary.total_records.toLocaleString()} total positions</div>
        </div>
        <div class="animate-count-up stagger-2 bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
          <div class="text-2xl sm:text-3xl font-extrabold">
            <span class="counter" data-target={(summary.unique_journals / 1000).toFixed(1)} data-suffix="K" data-decimals="1">0</span>
          </div>
          <div class="text-xs sm:text-sm text-blue-200 mt-1">Journals</div>
        </div>
        <div class="animate-count-up stagger-3 bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
          <div class="text-2xl sm:text-3xl font-extrabold">
            <span class="counter" data-target={summary.unique_publishers}>0</span>
          </div>
          <div class="text-xs sm:text-sm text-blue-200 mt-1">Publishers</div>
        </div>
        <div class="animate-count-up stagger-4 bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
          <div class="text-2xl sm:text-3xl font-extrabold">
            <span class="counter" data-target={summary.unique_countries}>0</span>
          </div>
          <div class="text-xs sm:text-sm text-blue-200 mt-1">Countries</div>
        </div>
      </div>
    </div>
  </section>

  <!-- City ticker -->
  <div class="bg-surface-dark overflow-hidden py-3 border-y border-white/5">
    <div class="ticker-wrapper relative">
      <div class="ticker-track flex gap-8 whitespace-nowrap" id="city-ticker">
        {[...topCities, ...topCities].map((text) => (
          <span class="text-sm text-blue-300/80 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full inline-block flex-shrink-0"></span>
            {text}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Highlights -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12">Dataset at a glance</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- h-index -->
      <div class="card-hover bg-white rounded-xl border border-border p-6 shadow-sm">
        <div class="w-10 h-10 bg-brand-100 text-brand-700 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="text-3xl font-bold text-brand-900">
          <span class="counter" data-target={summary.h_index_stats.mean} data-decimals="1">0</span>
        </div>
        <div class="text-sm text-text-secondary mt-1">Mean h-index</div>
        <div class="text-xs text-text-muted mt-2">
          Median: {summary.h_index_stats.median} &middot; Max: {summary.h_index_stats.max}
        </div>
      </div>

      <!-- ORCID coverage -->
      <div class="card-hover bg-white rounded-xl border border-border p-6 shadow-sm">
        <div class="w-10 h-10 bg-green-100 text-green-700 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-3xl font-bold text-green-800">
          <span class="counter" data-target={summary.pct_with_orcid} data-suffix="%" data-decimals="1">0</span>
        </div>
        <div class="text-sm text-text-secondary mt-1">Have ORCID</div>
        <div class="text-xs text-text-muted mt-2">
          {summary.with_orcid.toLocaleString()} out of {summary.unique_editors.toLocaleString()} unique editors
        </div>
      </div>

      <!-- Gender balance -->
      {pctFemale !== null ? (
        <div class="card-hover bg-white rounded-xl border border-border p-6 shadow-sm">
          <div class="w-10 h-10 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-amber-800">
            <span class="counter" data-target={pctFemale} data-suffix="%" data-decimals="1">0</span>
          </div>
          <div class="text-sm text-text-secondary mt-1">Female editors</div>
          <div class="text-xs text-text-muted mt-2">
            {femaleCount.toLocaleString()} out of {totalResolved.toLocaleString()} with resolved gender
          </div>
          {typeof pctGenderClassified === "number" && (
            <div class="text-[11px] text-text-muted mt-1">
              <a href="/methodology#gender" class="underline hover:text-amber-700">{pctGenderClassified}% of editors gender-classified</a> via WGND 2.0
            </div>
          )}
        </div>
      ) : (
        <div class="card-hover bg-white rounded-xl border border-border p-6 shadow-sm">
          <div class="w-10 h-10 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-amber-800">{topCountries[0][0]}</div>
          <div class="text-sm text-text-secondary mt-1">Most represented country</div>
          <div class="text-xs text-text-muted mt-2">
            {topCountries[0][1].toLocaleString()} positions
          </div>
        </div>
      )}

      <!-- Editors-in-Chief -->
      <div class="card-hover bg-white rounded-xl border border-border p-6 shadow-sm">
        <div class="w-10 h-10 bg-purple-100 text-purple-700 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div class="text-3xl font-bold text-purple-800">
          <span class="counter" data-target={eicCount} data-format="comma">0</span>
        </div>
        <div class="text-sm text-text-secondary mt-1">Editors-in-Chief</div>
        <div class="text-xs text-text-muted mt-2">
          Across {summary.unique_journals.toLocaleString()} journals
        </div>
      </div>
    </div>
  </section>

  <!-- Top countries + fields -->
  <section class="bg-surface-dim border-t border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Top countries -->
        <div>
          <h3 class="text-xl font-bold mb-6">Top countries by unique editors</h3>
          <div class="space-y-3">
            {topCountries.map(([country, count]) => {
              // top_countries is now keyed on unique editors per country
              // (per-editor dedup) — divide by unique_editors, not total_records,
              // otherwise the displayed share is ~14% instead of ~17% for the US.
              const pct = Math.round(((count as number) / summary.unique_editors) * 100);
              return (
                <div class="flex items-center gap-2 sm:gap-3">
                  <a href={`/country/${slugify(country)}`} class="w-24 sm:w-28 text-sm font-medium text-brand-600 hover:underline truncate">{country}</a>
                  <div class="flex-1 bg-white rounded-full h-5 overflow-hidden border border-border">
                    <div
                      class="h-full bg-brand-500 rounded-full"
                      style={`width: ${Math.max(pct * 2, 4)}%`}
                    />
                  </div>
                  <span class="text-xs font-semibold text-brand-700 w-8 text-right">{pct}%</span>
                  <span class="text-xs text-text-muted w-14 sm:w-16 text-right">{(count as number).toLocaleString()}</span>
                </div>
              );
            })}
          </div>
          <a href="/explore" class="inline-flex items-center mt-4 text-sm text-brand-600 hover:text-brand-800 font-medium">
            View all {summary.unique_countries} countries
            <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        <!-- Top fields -->
        <div>
          <h3 class="text-xl font-bold mb-6">Top scientific fields by unique editors</h3>
          <div class="space-y-3">
            {topFields.map(([field, count]) => {
              // Same per-editor basis as top_countries above — divide
              // by unique_editors, not total_records. Medicine reads
              // ~22% (162,978 / 745,125) rather than the wrong 16%.
              const pct = Math.round(((count as number) / summary.unique_editors) * 100);
              return (
                <div class="flex items-center gap-2 sm:gap-3">
                  <a href={`/field/${slugify(field)}`} class="w-28 sm:w-40 text-sm font-medium text-brand-600 hover:underline truncate" title={field}>{field}</a>
                  <div class="flex-1 bg-white rounded-full h-5 overflow-hidden border border-border">
                    <div
                      class="h-full bg-purple-500 rounded-full"
                      style={`width: ${Math.max(pct * 2.5, 4)}%`}
                    />
                  </div>
                  <span class="text-xs font-semibold text-purple-700 w-8 text-right">{pct}%</span>
                  <span class="text-xs text-text-muted w-14 sm:w-16 text-right">{(count as number).toLocaleString()}</span>
                </div>
              );
            })}
          </div>
          <a href="/explore" class="inline-flex items-center mt-4 text-sm text-brand-600 hover:text-brand-800 font-medium">
            View all fields
            <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How to cite -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6">Cite this dataset</h2>
      <p class="text-text-secondary mb-8">
        If you use Open Editors Plus in your research, please cite:
      </p>
      <div class="bg-surface-dim rounded-xl border border-border p-6 text-left">
        <p class="text-sm leading-relaxed text-text-primary">
          Chretien, B. (2026). <em>Open Editors Plus 2026: Editorial Board Composition of 15,000+ Academic Journals</em>.
          Zenodo. <span class="text-brand-600">https://doi.org/10.5281/zenodo.19590816</span>
        </p>
        <button
          id="copy-citation"
          class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-brand-700 bg-brand-50 rounded-lg hover:bg-brand-100 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
          </svg>
          Copy BibTeX
        </button>
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/cite" class="text-sm text-brand-600 hover:underline">More citation formats</a>
        <span class="text-text-muted">&middot;</span>
        <a href="/download" class="text-sm text-brand-600 hover:underline">Download from Zenodo</a>
        <span class="text-text-muted">&middot;</span>
        <span class="inline-flex items-center gap-1 text-sm text-text-muted">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          CC0 Public Domain
        </span>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="bg-surface-dim border-t border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12">What's in the dataset</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 bg-brand-100 text-brand-700 rounded-xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </div>
          <h3 class="font-semibold text-sm mb-1">{release.column_count} columns</h3>
          <p class="text-xs text-text-secondary">Name, role, affiliation, ORCID, gender (WGND 2.0 country-aware), bibliometrics, institution, geolocation</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-100 text-green-700 rounded-xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="font-semibold text-sm mb-1">Journal quality</h3>
          <p class="text-xs text-text-secondary">PubMed, Scopus, WoS, DOAJ, COPE indexing + NPI level + OpenAlex citedness quartile (per field)</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-purple-100 text-purple-700 rounded-xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="font-semibold text-sm mb-1">Bibliometrics</h3>
          <p class="text-xs text-text-secondary">h-index, publications, citations, academic age from OpenAlex</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="font-semibold text-sm mb-1">Board diversity</h3>
          <p class="text-xs text-text-secondary">Gender balance, country concentration (HHI), institution count per board</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // ─── Animated counters (triggered on scroll into view) ───
    function animateCounter(el) {
      const target = parseFloat(el.dataset.target);
      const suffix = el.dataset.suffix || "";
      const decimals = parseInt(el.dataset.decimals || "0");
      const useComma = el.dataset.format === "comma";
      const duration = 1800;
      const start = performance.now();

      function update(now) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        // Ease-out cubic
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = target * eased;

        if (useComma) {
          el.textContent = Math.round(current).toLocaleString() + suffix;
        } else if (decimals > 0) {
          el.textContent = current.toFixed(decimals) + suffix;
        } else {
          el.textContent = Math.round(current) + suffix;
        }

        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const counters = entry.target.querySelectorAll(".counter");
          counters.forEach((c, i) => {
            setTimeout(() => animateCounter(c), i * 150);
          });
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    // Observe both the hero stats and the glance cards
    document.querySelectorAll(".grid").forEach((grid) => {
      if (grid.querySelector(".counter")) counterObserver.observe(grid);
    });

    // ─── Copy citation ───
    document.getElementById("copy-citation")?.addEventListener("click", () => {
      const bibtex = `@dataset{chretien2026openeditors,
  author    = {Chretien, Basile},
  title     = {Open Editors Plus 2026: Editorial Board Composition of 15,000+ Academic Journals},
  year      = {2026},
  publisher = {Zenodo},
  doi       = {10.5281/zenodo.19590816},
  url       = {https://openeditors-plus.org}
}`;
      navigator.clipboard.writeText(bibtex);
      const btn = document.getElementById("copy-citation");
      if (btn) {
        const original = btn.innerHTML;
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg> Copied!`;
        setTimeout(() => { btn.innerHTML = original; }, 2000);
      }
    });
  </script>
</Base>
