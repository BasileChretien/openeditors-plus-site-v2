---
import "../styles/global.css";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  path?: string;
  breadcrumbs?: BreadcrumbItem[];
  schemaJson?: object;
}

const {
  title,
  description = "Open Editors Plus: 920,000+ editorial board positions across 15,000 academic journals. Explore who edits science.",
  path = "",
  breadcrumbs,
  schemaJson,
} = Astro.props;

const siteUrl = "https://openeditors-plus.org";
const canonicalUrl = `${siteUrl}/${path}`;

// Build breadcrumb schema
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.name,
      "item": b.url.startsWith("http") ? b.url : `${siteUrl}/${b.url}`,
    }))
  ]
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://gc.zgo.at; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data:; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://openeditors-plus.org; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://basile14.goatcounter.com blob:; worker-src blob:;" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | 920K+ Editorial Board Records`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Open Editors Plus" />
    <meta property="og:image" content={`${siteUrl}/img/og-preview.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/img/og-preview.png`} />

    <!-- Preconnect hints for faster explore page load -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://unpkg.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://unpkg.com" />

    <!-- Fonts (self-hosted, no external requests) -->

    <!-- Schema.org Dataset — SECURITY: set:html is safe here because all values are hardcoded. Do NOT interpolate user/external data without escaping. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": "Open Editors Plus 2026",
      "description": "Editorial board composition of 15,000+ academic journals with institutional, demographic, and bibliometric enrichment.",
      "url": siteUrl,
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "creator": {
        "@type": "Person",
        "name": "Basile Chretien",
        "affiliation": {
          "@type": "Organization",
          "name": "Neuropresage Team (PhIND, UMR-S U1237), Normandie Université, UNICAEN, INSERM, Caen, France"
        },
        "identifier": "https://orcid.org/0000-0002-7483-2489"
      },
      "temporalCoverage": "2026",
      "variableMeasured": [
        "Editorial board membership",
        "Editor bibliometrics (h-index, citations)",
        "Institutional affiliation (ROR)",
        "Geographic distribution",
        "Journal indexing status"
      ],
      "keywords": [
        "scientometrics",
        "editorial boards",
        "academic publishing",
        "gender equity",
        "geographic diversity",
        "open access"
      ],
      "distribution": [
        {
          "@type": "DataDownload",
          "encodingFormat": "text/csv",
          "contentUrl": "https://zenodo.org/records/19590816/files/openeditors_plus_2026.csv?download=1"
        },
        {
          "@type": "DataDownload",
          "encodingFormat": "application/x-parquet",
          "contentUrl": "https://zenodo.org/records/19590816/files/openeditors_plus_2026.parquet?download=1"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "name": "Zenodo",
        "url": "https://zenodo.org"
      },
      "identifier": "https://doi.org/10.5281/zenodo.19590816",
      "datePublished": "2026-04-30",
      "version": "2.7.0"
    })} />

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
