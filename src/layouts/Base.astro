          <a href="/" class="flex items-center gap-2 font-bold text-lg text-brand-900 hover:text-brand-700 transition-colors">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            Open Editors Plus
          </a>
          <div class="hidden sm:flex items-center gap-6 text-sm font-medium text-text-secondary">
            <a href="/explore" class="hover:text-brand-700 transition-colors">Explore</a>
            <a href="/publisher" class="hover:text-brand-700 transition-colors">Publishers</a>
            <a href="/country" class="hover:text-brand-700 transition-colors">Countries</a>
            <a href="/field" class="hover:text-brand-700 transition-colors">Fields</a>
            <a href="/institution" class="hover:text-brand-700 transition-colors">Institutions</a>
            <a href="/network" class="hover:text-brand-700 transition-colors">Network</a>
            <a href="/journals" class="hover:text-brand-700 transition-colors">Journals</a>
            <a href="/methodology" class="hover:text-brand-700 transition-colors">Methodology</a>
            <a href="/codebook" class="hover:text-brand-700 transition-colors">Codebook</a>
            <a href="/download" class="hover:text-brand-700 transition-colors">Download</a>
            <a href="/cite" class="hover:text-brand-700 transition-colors">Cite</a>
          </div>
          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="sm:hidden p-2 rounded-md hover:bg-surface-dim transition-colors"
            aria-label="Toggle menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
