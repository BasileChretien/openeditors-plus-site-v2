        </div>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden sm:hidden border-t border-border bg-white px-4 pb-4">
        <div class="flex flex-col gap-3 pt-3 text-sm font-medium text-text-secondary">
          <a href="/explore" class="hover:text-brand-700">Explore</a>
          <a href="/publisher" class="hover:text-brand-700">Publishers</a>
          <a href="/country" class="hover:text-brand-700">Countries</a>
          <a href="/field" class="hover:text-brand-700">Fields</a>
          <a href="/institution" class="hover:text-brand-700">Institutions</a>
          <a href="/network" class="hover:text-brand-700">Network</a>
          <a href="/journals" class="hover:text-brand-700">Journals</a>
          <a href="/methodology" class="hover:text-brand-700">Methodology</a>
          <a href="/codebook" class="hover:text-brand-700">Codebook</a>
          <a href="/download" class="hover:text-brand-700">Download</a>
          <a href="/cite" class="hover:text-brand-700">Cite</a>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-surface-dim border-t border-border mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="font-bold text-text-primary mb-3">Open Editors Plus</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              A comprehensive dataset of editorial board composition across 15,000+ academic journals.
              Created by <a href="https://orcid.org/0000-0002-7483-2489" class="text-brand-600 hover:underline" target="_blank" rel="noopener noreferrer">Basile Chretien</a>
              (Neuropresage Team, Normandie Université, UNICAEN, INSERM, Caen, France).
            </p>
          </div>
          <div>
            <h3 class="font-bold text-text-primary mb-3">Links</h3>
            <ul class="space-y-2 text-sm text-text-secondary">
              <li><a href="/explore" class="hover:text-brand-600">Explore the data</a></li>
              <li><a href="/download" class="hover:text-brand-600">Download (Zenodo)</a></li>
              <li><a href="/methodology" class="hover:text-brand-600">Methodology</a></li>
              <li><a href="/cite" class="hover:text-brand-600">How to cite</a></li>
              <li><a href="/privacy" class="hover:text-brand-600">Privacy &amp; data protection</a></li>
              <li><a href="/corrections" class="hover:text-brand-600">Corrections &amp; data rights</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-text-primary mb-3">License & Support</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-3">
              Released under
              <a href="https://creativecommons.org/publicdomain/zero/1.0/" class="text-brand-600 hover:underline" target="_blank" rel="noopener noreferrer">CC0 1.0</a>
              (public domain). Please cite when reusing. CC0 covers copyright and
              database rights, not the data-protection rights of listed individuals —
              see <a href="/privacy" class="text-brand-600 hover:underline">Privacy</a>.
            </p>
            <a
              href="https://buymeacoffee.com/basile.chretien"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-amber-400 text-amber-950 text-sm font-semibold rounded-lg hover:bg-amber-300 transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.185-1.756.218-.95.053-1.9.025-2.849-.024-.652-.035-1.301-.091-1.938-.209-.637-.117-1.036-.56-1.098-1.22l-.517-5.059c-.095-.925-.202-1.849-.295-2.773-.054-.53.064-1.032.506-1.403.416-.35.965-.445 1.487-.377.29.039.57.111.848.189.168.047.158.185.012.236-.326.112-.623.26-.861.498-.282.28-.382.665-.337 1.053l.455 4.413c.068.661.134 1.322.2 1.983.052.504.21.906.72 1.03 1.157.282 2.34.321 3.502.104.532-.1.895-.411.995-.94.122-.647.13-1.306.18-1.96.105-1.395.204-2.79.309-4.185.069-.91.15-1.82.222-2.73.006-.075.038-.14.12-.148l.273-.022c1.012-.075 2.012-.244 2.966-.584.578-.206.967-.648 1.038-1.27.074-.656-.073-1.328.062-1.978z"/></svg>
              Support this project
            </a>
            <p class="text-xs text-text-muted mt-2">Data v2.7.0 &middot; Last updated April 30, 2026</p>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));

      // Assemble obfuscated data-rights email links (see ContactEmail.astro):
      // the halves are stored base64-encoded, so neither the plain address nor
      // a "user [at] domain" form is present in the static HTML. Only the
      // browser decodes them, reveals the address as the link text, and builds
      // the mailto: href.
      document.querySelectorAll(".oep-eml").forEach((el) => {
        const a = el as HTMLAnchorElement;
        const eu = a.getAttribute("data-eu");
        const ed = a.getAttribute("data-ed");
        const s = a.getAttribute("data-s");
        if (!eu || !ed) return;
        let u, d;
        try { u = atob(eu); d = atob(ed); } catch { return; }
        const addr = u + "@" + d;
        // Encode each half defensively so a future dynamic address can't inject
        // mailto headers; today these are inert string literals.
        a.href = "mailto:" + encodeURIComponent(u) + "@" + encodeURIComponent(d) +
          (s ? "?subject=" + encodeURIComponent(s) : "");
        a.textContent = addr;
      });
    </script>

    <!-- GoatCounter analytics (privacy-friendly, no cookies) -->
    <script data-goatcounter="https://basile14.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
